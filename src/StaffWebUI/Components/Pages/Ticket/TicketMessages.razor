@using Microsoft.FluentUI.AspNetCore.Components
@using eShopSupport.ServiceDefaults.Clients.Backend

@if (Ticket is null)
{
    <div class="loading-progress">
        <FluentProgress />
    </div>
}
else
{
    <div class="messages">
        @if (!string.IsNullOrEmpty(Ticket?.LongSummary))
        {
            <div class="summary">
                <div class="summary-text">
                    <div>💡</div>
                    <div>
                        <strong>Summary:</strong>
                        @Ticket.LongSummary
                    </div>
                </div>
            </div>
        }

        @* AI Triage Section - At the very top *@
        @if (TriageInfo != null)
        {
            var urgencyClass = TriageInfo.UrgencyLevel.ToLower();
            var urgencyEmoji = TriageInfo.UrgencyLevel switch
            {
                "Critical" => "🔴",
                "High" => "🟠",
                "Medium" => "🟡",
                "Low" => "🟢",
                _ => "⚪"
            };

            <div class="message agent-triage urgency-@urgencyClass">
                <div class="agent-triage-header">
                    <span class="agent-icon">🎯</span>
                    <span class="agent-title">AI TRIAGE ANALYSIS</span>
                </div>
                <div class="agent-triage-content">
                    <div class="triage-summary">
                        <div class="triage-item">
                            <strong>Type:</strong> @TriageInfo.TicketType
                        </div>
                        <div class="triage-item">
                            <strong>Priority:</strong> @urgencyEmoji @TriageInfo.UrgencyLevel (@TriageInfo.PriorityScore/10)
                        </div>
                        @if (TriageInfo.RecommendedAgent != null)
                        {
                            <div class="triage-item">
                                <strong>Recommended Agent:</strong> @TriageInfo.RecommendedAgent
                            </div>
                        }
                        @if (TriageInfo.RequiresEscalation)
                        {
                            <div class="triage-item escalation-warning">
                                ⚠️ <strong>ESCALATION REQUIRED</strong> - Needs immediate human attention
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* AI Research Section - Always at top *@
        @{
            var researchMessage = Ticket!.Messages.FirstOrDefault(m => m.MessageType == ServiceDefaults.Clients.Backend.MessageType.AgentResearch);
        }

        @if (IsResearching)
        {
            <div class="message agent-research researching">
                <div class="agent-research-header">
                    <span class="agent-icon">🤖</span>
                    <span class="agent-title">AI RESEARCH IN PROGRESS</span>
                    <FluentProgressRing style="width: 20px; height: 20px;" />
                </div>
                <div class="agent-research-content">
                    <div class="typing-indicator">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                    <p style="margin: 0; font-style: italic; color: #666;">Analyzing customer context, searching knowledge base, and preparing recommendations...</p>
                </div>
            </div>
        }
        else if (researchMessage != null)
        {
            <div class="message agent-research">
                <div class="agent-research-header">
                    <span class="agent-icon">🤖</span>
                    <span class="agent-title">AI RESEARCH (Internal - Not sent to customer)</span>
                    <span class="timestamp">@researchMessage.CreatedAt.ToShortTimeString()</span>
                </div>
                <div class="agent-research-content">
                    <pre style="white-space: pre-wrap; font-family: inherit;">@researchMessage.MessageText</pre>
                </div>
            </div>
        }

        @* AI Draft Response Section *@
        @if (DraftResponse != null)
        {
            <div class="message agent-draft">
                <div class="agent-draft-header">
                    <span class="agent-icon">✍️</span>
                    <span class="agent-title">AI DRAFT RESPONSE</span>
                    <span class="confidence" title="@GetConfidenceFactorsTooltip()">Confidence: @((DraftResponse.Confidence * 100).ToString("F0"))%</span>
                </div>
                <div class="agent-draft-content">
                    <div class="draft-text">@DraftResponse.DraftContent</div>
                    @if (!string.IsNullOrEmpty(DraftResponse.Rationale))
                    {
                        <div class="draft-rationale">
                            <strong>Rationale:</strong> @DraftResponse.Rationale
                        </div>
                    }
                </div>
                <div class="agent-draft-actions">
                    <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.Send())" OnClick="@OnApproveDraft">
                        Approve & Send
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Neutral" IconStart="@(new Icons.Regular.Size20.Edit())" OnClick="@OnEditDraft">
                        Edit
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Lightweight" IconStart="@(new Icons.Regular.Size20.Dismiss())" OnClick="@OnRejectDraft">
                        Reject
                    </FluentButton>
                </div>
            </div>
        }
        else if (DraftRejected)
        {
            <div class="message agent-draft-rejected">
                <div class="agent-draft-header">
                    <span class="agent-icon">❌</span>
                    <span class="agent-title">DRAFT REJECTED</span>
                </div>
                <div class="agent-draft-content">
                    <p>The draft response was rejected. You can generate a new one or write your own response.</p>
                </div>
                <div class="agent-draft-actions">
                    <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.ArrowSync())" OnClick="@OnRegenerateDraft">
                        Generate New Draft
                    </FluentButton>
                </div>
            </div>
        }

        @* Customer and Staff Messages *@
        @foreach (var message in Ticket!.Messages.Where(m => m.MessageType != ServiceDefaults.Clients.Backend.MessageType.AgentResearch))
        {
            <div class="message @(message.IsCustomerMessage ? "customer" : "support")">
                <div class="message-metadata">
                    <span class="timestamp">@message.CreatedAt.ToShortDateString()</span>
                    <span class="filler">by</span>
                    <span class="sender">@(message.IsCustomerMessage ? Ticket.CustomerFullName : "Support")</span>
                </div>
                <div class="message-text">@message.MessageText</div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public TicketDetailsResult? Ticket { get; set; }

    [Parameter]
    public TriageInfo? TriageInfo { get; set; }

    [Parameter]
    public bool IsResearching { get; set; }

    [Parameter]
    public DraftResult? DraftResponse { get; set; }

    [Parameter]
    public bool DraftRejected { get; set; }

    [Parameter]
    public EventCallback OnApproveDraft { get; set; }

    [Parameter]
    public EventCallback OnEditDraft { get; set; }

    [Parameter]
    public EventCallback OnRejectDraft { get; set; }

    [Parameter]
    public EventCallback OnRegenerateDraft { get; set; }

    private string GetConfidenceFactorsTooltip()
    {
        if (DraftResponse?.ConfidenceFactors == null || DraftResponse.ConfidenceFactors.Count == 0)
        {
            return "No confidence factors available";
        }

        return "Confidence Calculation:\n" + string.Join("\n", DraftResponse.ConfidenceFactors);
    }
}
