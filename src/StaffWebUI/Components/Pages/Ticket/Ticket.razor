@page "/ticket/{ticketId:int}"
@inherits RedisSubscribingComponent
@using Microsoft.FluentUI.AspNetCore.Components
@using StackExchange.Redis
@using eShopSupport.ServiceDefaults.Clients.Backend
@inject StaffBackendClient Backend

<Title>Ticket @TicketId</Title>

<div class="ticket">
    <FluentMultiSplitter Class="splitter" Style="width: 100%; height: 100%;">
        <FluentMultiSplitterPane Min="300px" Size="1fr" Resizable="true">
            <div class="details">
                @if (ticket is not null)
                {
                    <TicketDetails Ticket="@ticket" IsAssistantCollapsed="@isAssistantCollapsed" OnToggleAssistant="@(() => isAssistantCollapsed = !isAssistantCollapsed)" />
                }
            </div>
            <div class="messages">
                <TicketMessages Ticket="@ticket" TriageInfo="@triageInfo" IsResearching="@isResearching" DraftResponse="@draftResponse" DraftRejected="@draftRejected" OnApproveDraft="@ApproveDraftAsync" OnEditDraft="@EditDraft" OnRejectDraft="@ShowRejectDialog" OnRegenerateDraft="@RegenerateDraftAsync" />
            </div>
            <div class="write-message">
                <EditForm EditContext="@editContext" OnValidSubmit="@SendReplyAsync">
                    <FluentTextArea @ref="replyTextArea" @bind-Value="@replyText" Placeholder="Reply to the customer" style="width: 100%; height: 100%;" />
                    <div class="actions">
                        @if (!isSending)
                        {
                            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" IconStart="@sendIcon">Send</FluentButton>
                        }
                        else
                        {
                            <FluentProgressRing />
                        }
                    </div>
                </EditForm>
            </div>
        </FluentMultiSplitterPane>
        <FluentMultiSplitterPane Size="350px" Min="200px" Collapsible="true" Collapsed="@isAssistantCollapsed">
            <div class="assistant">
                <TicketAssistant Ticket="@ticket" OnSuggestedReply="@AcceptSuggestedReply" />
            </div>
        </FluentMultiSplitterPane>
    </FluentMultiSplitter>
</div>

<FluentDialog @ref="rejectDialog" @bind-Hidden="@hideRejectDialog" Modal="true" TrapFocus="true">
    <DialogTitle>Reject Draft Response</DialogTitle>
    <DialogContent>
        <p>Why are you rejecting this draft? (Optional)</p>
        <FluentTextArea @bind-Value="@rejectionReason" Placeholder="e.g., Too formal, Missing key details, Incorrect information..." style="width: 100%; min-height: 100px;" />
    </DialogContent>
    <DialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="@ConfirmRejectAsync">Reject</FluentButton>
        <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => hideRejectDialog = true)">Cancel</FluentButton>
    </DialogFooter>
</FluentDialog>

@code {
    private readonly Icon sendIcon = new Icons.Regular.Size20.Mail();
    private EditContext editContext;
    private TicketDetailsResult? ticket;
    private string? replyText;
    private FluentTextArea? replyTextArea;
    private bool isSending;
    private bool isResearching;
    private TriageInfo? triageInfo;
    private DraftResult? draftResponse;
    private int? draftId;
    private bool draftRejected;
    private FluentDialog? rejectDialog;
    private bool hideRejectDialog = true;
    private string? rejectionReason;
    private bool isAssistantCollapsed = true;

    [Parameter]
    public int TicketId { get; set; }

    public Ticket() => editContext = new(this);

    protected override async Task OnParametersSetAsync()
    {
        // Reset state when navigating to a different ticket
        ticket = null;
        triageInfo = null;
        draftResponse = null;
        draftId = null;
        draftRejected = false;
        isResearching = false;

        ticket = await Backend.GetTicketDetailsAsync(TicketId);

        SubscriptionChannel = RedisChannel.Literal($"ticket:{TicketId}");

        // Trigger agent triage (research + draft) if not already done
        TriggerTriageAsync();
    }

    private async void TriggerTriageAsync()
    {
        // Check if triage already exists
        var hasExistingResearch = ticket?.Messages.Any(m => m.MessageType == ServiceDefaults.Clients.Backend.MessageType.AgentResearch) == true;

        if (hasExistingResearch)
        {
            // Load existing triage data
            _ = Task.Run(async () =>
            {
                var result = await Backend.TriggerTicketTriageAsync(TicketId);

                await InvokeAsync(() =>
                {
                    if (result != null && result.Success)
                    {
                        triageInfo = result.Triage;
                        draftResponse = result.Draft;
                        draftId = result.DraftId;
                    }
                    StateHasChanged();
                });
            });
            return;
        }

        // Show research in progress
        isResearching = true;
        StateHasChanged();

        // Trigger triage in the background
        _ = Task.Run(async () =>
        {
            await Task.Delay(1000); // Small delay to let page load
            var result = await Backend.TriggerTicketTriageAsync(TicketId);

            // Hide progress and update state
            await InvokeAsync(async () =>
            {
                isResearching = false;
                if (result != null && result.Success)
                {
                    ticket = await Backend.GetTicketDetailsAsync(TicketId);
                    triageInfo = result.Triage;
                    draftResponse = result.Draft;
                    draftId = result.DraftId;
                }
                StateHasChanged();
            });
        });
    }

    private void AcceptSuggestedReply(string suggestion)
    {
        replyText = suggestion;
        replyTextArea?.FocusAsync();
        editContext.NotifyFieldChanged(FieldIdentifier.Create(() => replyText));
    }

    private async Task SendReplyAsync()
    {
        if (string.IsNullOrWhiteSpace(replyText))
        {
            return;
        }

        isSending = true;
        var sendTask = Backend.SendTicketMessageAsync(TicketId, new(replyText));
        await Task.WhenAll(sendTask, Task.Delay(500));

        replyText = null;
        editContext.MarkAsUnmodified();
        ticket = await Backend.GetTicketDetailsAsync(TicketId);

        // To avoid having the "send" button flash into existence before animating away,
        // keep the spinner on screen for a further 1s, giving time for the animation to complete
        StateHasChanged();
        await Task.Delay(1000);
        isSending = false;
    }

    private async Task ApproveDraftAsync()
    {
        if (draftResponse == null) return;

        // Send the draft as-is to the customer
        isSending = true;
        StateHasChanged();

        await Backend.SendTicketMessageAsync(TicketId, new(draftResponse.DraftContent));

        // Clear draft and refresh ticket
        draftResponse = null;
        draftId = null;
        ticket = await Backend.GetTicketDetailsAsync(TicketId);

        await Task.Delay(1000);
        isSending = false;
        StateHasChanged();
    }

    private void EditDraft()
    {
        if (draftResponse == null) return;

        // Copy draft to textbox for editing
        replyText = draftResponse.DraftContent;
        editContext.NotifyFieldChanged(FieldIdentifier.Create(() => replyText));

        // Clear draft (it's now in the textbox)
        draftResponse = null;
        StateHasChanged();

        // Focus the textbox
        replyTextArea?.FocusAsync();
    }

    private void ShowRejectDialog()
    {
        hideRejectDialog = false;
        rejectionReason = null;
        StateHasChanged();
    }

    private async Task ConfirmRejectAsync()
    {
        if (draftId == null) return;

        hideRejectDialog = true;

        // Persist rejection in database
        var success = await Backend.RejectDraftAsync(draftId.Value, rejectionReason);

        if (success)
        {
            // Clear draft from UI and mark as rejected
            draftResponse = null;
            draftRejected = true;
            StateHasChanged();
        }
    }

    private async Task RegenerateDraftAsync()
    {
        isResearching = true;
        draftRejected = false;
        StateHasChanged();

        var newDraft = await Backend.RegenerateDraftAsync(TicketId);

        isResearching = false;

        if (newDraft != null)
        {
            draftResponse = newDraft;
            // Get the new draft ID by refreshing ticket data
            ticket = await Backend.GetTicketDetailsAsync(TicketId);
        }

        StateHasChanged();
    }

    protected override async Task OnRedisNotificationAsync(RedisValue value)
        => ticket = await Backend.GetTicketDetailsAsync(TicketId);
}
